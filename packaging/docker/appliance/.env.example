# Boot env for the OpenWork chat stack (docker-compose.dev.yml + appliance override).
# Copy to ../.env and set OPENWORK_PUBLIC_HOST to this box's reachable hostname.
OPENWORK_PUBLIC_HOST=gx10-017d
OPENWORK_PORT=8787
WEB_PORT=5173
OPENWORK_WORKSPACE=./workspace
OPENWORK_DATA_DIR=/workspace/.openwork
OPENWORK_DEV_MODE=1
