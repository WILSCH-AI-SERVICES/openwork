# .env.example — Bare Block A unified appliance (#1033).
# Copy to ../appliance.env and fill per-box values. Loaded by docker-compose.appliance.yml.

# --- The box's own address (Part 7: filled in at setup, never baked into the build) ---
DEN_PUBLIC_HOST=192.168.1.123

# --- Fixed appliance ports ---
OPENWORK_PORT=8787
DEN_API_PORT=8788
DEN_WEB_PORT=3005
DEN_WORKER_PROXY_PORT=8789
DEN_MYSQL_PORT=3306

# --- Den auth (Better Auth). GENERATE A FRESH SECRET PER BOX: openssl rand -hex 32 ---
DEN_BETTER_AUTH_SECRET=CHANGE-ME-generate-with-openssl-rand-hex-32
# Auth origin = the address the operator's browser uses to reach Den web (LAN on a real client box;
# a Tailscale host for a remote sandbox). Must be in CORS/trusted origins below.
DEN_BETTER_AUTH_URL=http://192.168.1.123:3005
DEN_CORS_ORIGINS=http://192.168.1.123:3005,http://192.168.1.123:8788,http://localhost:3005,http://127.0.0.1:3005
OPENWORK_DEV_MODE=1

# --- Worker provisioning: box-provision.sh creates a destination:"local" worker, launches the
#     orchestrator with that worker's Den tokens, and WRITES the four vars below back into this file
#     so a later `docker compose ... up` reconnects with the same durable token (#1038, AC3).
#     Leave these blank here — box-provision.sh fills them at provision time. ---
DEN_PROVISIONER_MODE=stub
OPENWORK_TOKEN=
OPENWORK_HOST_TOKEN=

# Browser-side wire for the chat-spa SPA (VITE_-prefixed → import.meta.env). box-provision.sh sets
# VITE_OPENWORK_URL to the box's browser-reachable worker address (tailscale) and VITE_OPENWORK_TOKEN
# to the Den-minted client token; the SPA hydrates both on boot — no connect-remote page, no source fork.
VITE_OPENWORK_URL=
VITE_OPENWORK_TOKEN=

# --- Offline-clean: the one confirmation code streams to the box console (no outside mail) ---
DEN_WATCH_OTP_CODES=1
